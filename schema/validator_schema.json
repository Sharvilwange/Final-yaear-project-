{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Procedural 3D Validation Result",
  "type": "object",
  "required": [
    "valid",
    "errors",
    "warnings",
    "corrections"
  ],
  "additionalProperties": false,
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/correction"
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "required": [
        "type",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "correction": {
      "type": "object",
      "required": [
        "target",
        "action",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}